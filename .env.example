# ===========================================
# Lead Prospector - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your API keys

# Google Places API Key
# Get it from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Places API (New)
# Pricing: ~$17 per 1000 requests for basic, ~$32 for details
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Yelp Fusion API Key  
# Get it from: https://www.yelp.com/developers/v3/manage_app
# Free tier: 5000 API calls/day
YELP_API_KEY=your_yelp_api_key_here

# Optional: Google PageSpeed Insights API Key
# Not required for basic usage (works without key but rate-limited)
# Get it from: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# ===========================================
# How to get API Keys:
# ===========================================
#
# GOOGLE PLACES API:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or select existing)
# 3. Enable "Places API" and "Places API (New)"
# 4. Go to Credentials > Create Credentials > API Key
# 5. Optionally restrict the key to Places API only
# 6. Copy the key here
#
# YELP FUSION API:
# 1. Go to https://www.yelp.com/developers
# 2. Sign up or log in
# 3. Create a new app at https://www.yelp.com/developers/v3/manage_app
# 4. Copy the API Key (not the Client ID)
# 5. Paste it here
#
# ===========================================
