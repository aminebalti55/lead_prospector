# ===========================================
# Lead Prospector - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# EMAIL CONFIGURATION (Required for sending)
# ===========================================
# SMTP settings for sending outreach emails

# Gmail SMTP (recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Your sender name (appears in "From" field)
SENDER_NAME=Your Name

# ===========================================
# API KEYS (Optional - for enhanced features)
# ===========================================

# Google Places API Key
# Get it from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Places API (New)
# Pricing: ~$17 per 1000 requests for basic, ~$32 for details
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Yelp Fusion API Key  
# Get it from: https://www.yelp.com/developers/v3/manage_app
# Free tier: 5000 API calls/day
YELP_API_KEY=your_yelp_api_key_here

# Optional: Google PageSpeed Insights API Key
# Not required for basic usage (works without key but rate-limited)
# Get it from: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
#
# GMAIL APP PASSWORD (Required for email):
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Windows Computer"
# 5. Click "Generate" - you'll get a 16-character password
# 6. Copy that password to SMTP_PASSWORD above
# 7. Use your Gmail address for SMTP_USER
#
# GOOGLE PLACES API:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or select existing)
# 3. Enable "Places API" and "Places API (New)"
# 4. Go to Credentials > Create Credentials > API Key
# 5. Optionally restrict the key to Places API only
# 6. Copy the key here
#
# YELP FUSION API:
# 1. Go to https://www.yelp.com/developers
# 2. Sign up or log in
# 3. Create a new app at https://www.yelp.com/developers/v3/manage_app
# 4. Copy the API Key (not the Client ID)
# 5. Paste it here
#
# ===========================================
